# ===========================================
# LE PARADISIER MANAGER - Configuration
# ===========================================
# 
# INSTRUCTIONS:
# 1. Copiez ce fichier vers .env : cp .env.example .env
# 2. Remplissez les valeurs ci-dessous
# 3. Ne commitez JAMAIS le fichier .env !
#
# ===========================================

# ───────────────────────────────────────────
# ENVIRONNEMENT
# ───────────────────────────────────────────
# development = mode développement local
# production = mode production (Render, etc.)
NODE_ENV=development

# Port du serveur (Render utilise automatiquement 10000)
PORT=3000

# ───────────────────────────────────────────
# BASE DE DONNÉES POSTGRESQL
# ───────────────────────────────────────────
# 
# FORMAT: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# ▸ Supabase (recommandé):
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# ▸ Neon:
#   postgresql://[user]:[password]@[host].neon.tech/[database]?sslmode=require
#
# ▸ Railway:
#   Utilisez l'URL fournie dans les variables Railway
#
# ▸ Local:
#   postgresql://postgres:password@localhost:5432/paradisier_db
#
DATABASE_URL=postgresql://postgres:password@localhost:5432/paradisier_db

# Connexions pool (optionnel, valeurs par défaut correctes)
DB_POOL_MIN=2
DB_POOL_MAX=10

# SSL obligatoire pour Supabase/Neon/Railway en production
# true = production cloud, false = développement local
DB_SSL=false

# ───────────────────────────────────────────
# SÉCURITÉ JWT
# ───────────────────────────────────────────
#
# ⚠️  IMPORTANT: Générez des clés UNIQUES pour la production !
#
# Pour générer une clé sécurisée, exécutez:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Ou utilisez: https://randomkeygen.com (CodeIgniter Encryption Keys)
#

# Clé secrète pour les access tokens (minimum 32 caractères)
JWT_SECRET=CHANGEZ_MOI_clé_secrète_minimum_32_caractères

# Clé secrète pour les refresh tokens (différente de JWT_SECRET)
JWT_REFRESH_SECRET=CHANGEZ_MOI_autre_clé_secrète_minimum_32_caractères

# Durée de validité des tokens
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ───────────────────────────────────────────
# CORS - Origines autorisées
# ───────────────────────────────────────────
#
# Liste des domaines autorisés à accéder à l'API (séparés par des virgules)
#
# ▸ Développement:
#   http://localhost:5500,http://127.0.0.1:5500
#
# ▸ Production (exemples):
#   https://foriasser-hub.github.io,https://votre-app.vercel.app
#
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001

# ───────────────────────────────────────────
# RATE LIMITING (Protection contre les abus)
# ───────────────────────────────────────────
# Fenêtre de temps en millisecondes (15 min = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Nombre max de requêtes par fenêtre
RATE_LIMIT_MAX_REQUESTS=100

# Limite spéciale pour les tentatives de connexion
LOGIN_RATE_LIMIT_MAX=5

# ───────────────────────────────────────────
# LOGS
# ───────────────────────────────────────────
# Niveaux: error, warn, info, http, verbose, debug
LOG_LEVEL=info

# ───────────────────────────────────────────
# APPLICATION
# ───────────────────────────────────────────
APP_NAME=Le Paradisier Manager
APP_CURRENCY=Ar
APP_PHONE=+261 34 00 000 00
APP_ADDRESS=Toamasina, Madagascar

# ───────────────────────────────────────────
# ADMIN PAR DÉFAUT
# ───────────────────────────────────────────
# Ces valeurs sont utilisées uniquement lors du premier seed
# L'admin sera OBLIGÉ de changer son mot de passe à la première connexion
#
# ⚠️  Ne modifiez PAS ces valeurs après le déploiement initial
#
DEFAULT_ADMIN_EMAIL=admin@paradisier.mg
DEFAULT_ADMIN_PASSWORD=Admin@123!
