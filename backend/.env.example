# ===========================================
# LE PARADISIER MANAGER - Configuration
# ===========================================
# Copiez ce fichier vers .env et remplissez les valeurs

# Environnement
NODE_ENV=development
PORT=3000

# Base de données PostgreSQL
# Pour Supabase: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Pour Railway/Neon: utilisez l'URL de connexion fournie
DATABASE_URL=postgresql://username:password@localhost:5432/paradisier_db

# Configuration des connexions DB
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# JWT - Sécurité (IMPORTANT: Générez des clés uniques en production!)
# Utilisez: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-refresh-token-secret-also-minimum-32-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Logs
LOG_LEVEL=info

# Admin par défaut (uniquement pour la première initialisation)
DEFAULT_ADMIN_EMAIL=admin@paradisier.mg
DEFAULT_ADMIN_PASSWORD=Admin@123!

# Application
APP_NAME=Le Paradisier Manager
APP_CURRENCY=Ar
APP_PHONE=+261 34 00 000 00
APP_ADDRESS=Toamasina, Madagascar
